<?xml version="1.0"?>
<ruleset name="QuipXml">
  <description>Drupal coding standards for QuipXml</description>

  <file>src</file>
  <file>tests</file>

  <arg name="extensions" value="php"/>
  <arg name="colors"/>
  <arg value="sp"/>
  <arg value="n"/>

  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>
  <rule ref="Generic.PHP.RequireStrictTypes"/>

  <rule ref="Drupal.Commenting.Deprecated.IncorrectTextLayout">
    <severity>0</severity>
  </rule>

  <rule ref="Drupal.Commenting.Deprecated.DeprecatedWrongSeeUrlFormat">
    <severity>0</severity>
  </rule>
</ruleset>
