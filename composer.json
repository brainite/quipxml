{
    "name": "brainite/quipxml",
    "type": "library",
    "description": "Enhanced SimpleXml-based toolkit",
    "keywords": [
        "xml"
    ],
    "homepage": "https://github.com/brainite/quipxml",
    "license": "MIT",
    "authors": [
        {
            "name": "Greg Payne",
            "homepage": "https://brainite.org/",
            "role": "Packager"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-simplexml": "*"
    },
    "require-dev": {
        "drupal/coder": "^8.3",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5 || ^13.3"
    },
    "autoload": {
        "psr-4": {
            "QuipXml\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "QuipXml\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "analyse": "phpstan analyse --no-progress",
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    }
}
